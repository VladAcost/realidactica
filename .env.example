# Aplicación
APP_ENV=development
SECRET_KEY=genera-una-clave-aleatoria-larga
APP_BASE_URL=http://localhost:8080
HOST=127.0.0.1
PORT=8080
FLASK_DEBUG=0

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=realidactica
MYSQL_PASSWORD=cambia-esta-contrasena
MYSQL_DB=realidactica

# OpenAI Responses API
OPENAI_API_KEY=coloca-tu-clave-en-el-entorno
OPENAI_MODEL=gpt-5.6-terra
ENGLISH_OPENAI_MODEL=gpt-5.6-luna

# Voz femenina y transcripción de ElevenLabs. Usa una clave nueva como variable del servidor.
ELEVENLABS_API_KEY=coloca-tu-clave-en-el-entorno
# Opcional: fija una voz femenina concreta; vacío elige la primera voz femenina disponible.
ELEVENLABS_VOICE_ID=

# Solo para demostraciones locales. Se ignora cuando APP_ENV=production.
DEMO_MODE=0
DEMO_STUDENT_USERNAME=
DEMO_STUDENT_PASSWORD=
DEMO_TEACHER_USERNAME=
DEMO_TEACHER_PASSWORD=

# Sembrado opcional y temporal de un usuario activo durante el arranque.
BOOTSTRAP_DEMO_USERNAME=
BOOTSTRAP_DEMO_EMAIL=
BOOTSTRAP_DEMO_PASSWORD=
BOOTSTRAP_DEMO_ROLE=alumno

# Confirmación de correo
GMAIL_USER=cuenta@gmail.com
GMAIL_APP_PASSWORD=contraseña-de-aplicacion

# Opcional
LOG_LEVEL=INFO
UPLOAD_FOLDER=uploads/materials
# Opcional: ruta de SQLite en un volumen persistente. Vacío usa instance/diagnostics.sqlite3.
DIAGNOSTICS_DB_PATH=
